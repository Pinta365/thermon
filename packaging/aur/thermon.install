post_install() {
  echo '==> Start the daemon for your user:'
  echo '      systemctl --user enable --now thermond'
  echo '==> The Omarchy bar plugin is installed separately:'
  echo '      omarchy plugin add https://github.com/Pinta365/omarchy-thermon.git --enable'
}

post_upgrade() {
  echo '==> Restart the daemon to use the new version:'
  echo '      systemctl --user restart thermond'
}
